{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/config/r1/budget-policy.schema.json",
  "title": "Recharge budget and containment policy (proposed, not applied)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "proposed",
        "accepted"
      ]
    },
    "decisionRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "currency": {
      "const": "EUR"
    },
    "guardrailMonthlyEur": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "thresholdsPercent": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "anomalyAlerts": {
      "type": "boolean"
    },
    "responseOwnerRole": {
      "enum": [
        "Finance owner",
        "Operations owner"
      ]
    },
    "notificationChannelRefs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "hardStop": {
      "const": false
    },
    "automaticBillingDetach": {
      "const": false
    },
    "containment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mechanism": {
          "const": "serverFlagsAndQuotas"
        },
        "killSwitchIds": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9.]*$"
          }
        },
        "neverBlocked": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9.]*$"
          }
        },
        "manualBillingActionIsLastResort": {
          "const": true
        }
      },
      "required": [
        "mechanism",
        "killSwitchIds",
        "neverBlocked",
        "manualBillingActionIsLastResort"
      ]
    }
  },
  "required": [
    "status",
    "decisionRef",
    "currency",
    "guardrailMonthlyEur",
    "thresholdsPercent",
    "anomalyAlerts",
    "responseOwnerRole",
    "notificationChannelRefs",
    "hardStop",
    "automaticBillingDetach",
    "containment"
  ]
}
