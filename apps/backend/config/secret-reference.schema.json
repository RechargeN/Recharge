{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/config/r1/secret-reference.schema.json",
  "title": "Recharge R1 logical secret reference",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "environmentId": { "enum": ["local", "dev", "stage", "prod"] },
    "logicalName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "provider": { "const": "gcpSecretManager" },
    "referenceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "bindingState": { "const": "unbound" }
  },
  "required": [
    "schemaVersion",
    "environmentId",
    "logicalName",
    "provider",
    "referenceName",
    "bindingState"
  ]
}
