{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/config/r1/region-policy.schema.json",
  "title": "Recharge R1 logical region policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "environmentId": { "enum": ["local", "dev", "stage", "prod"] },
    "firestoreLocation": { "const": "eur3" },
    "functionsRegion": { "const": "europe-west1" },
    "storageRegion": { "const": "europe-west1" },
    "exportLocation": { "const": "EU" },
    "activationState": { "const": "disabled" }
  },
  "required": [
    "schemaVersion",
    "policyId",
    "revision",
    "environmentId",
    "firestoreLocation",
    "functionsRegion",
    "storageRegion",
    "exportLocation",
    "activationState"
  ]
}
