{
  "name": "@recharge/backend-r0-functions",
  "version": "0.0.0-r0",
  "private": true,
  "description": "Local R1 platform and disabled Booking Emulator foundation for Recharge",
  "type": "module",
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "verify:cloud-context": "node ../scripts/verify-no-cloud-context.mjs",
    "verify:toolchain": "node ../scripts/verify-toolchain.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.mjs\" \"../*.json\" \"../scripts/*.mjs\"",
    "format:check": "prettier --check --end-of-line auto \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.mjs\" \"../*.json\" \"../scripts/*.mjs\"",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test:unit": "npm run build --silent && node --test --experimental-test-isolation=none \"lib/test/unit/**/*.test.js\"",
    "test:contract": "npm run build --silent && node --test --experimental-test-isolation=none \"lib/test/contract/*.test.js\"",
    "test:emulator:raw-body": "node ../scripts/run-booking-raw-body-probe.mjs",
    "test:emulator:booking-core:inside": "node lib/test/emulator/event_booking_projection.test.js && node lib/test/emulator/event_booking_delivery_scheduler.test.js && node lib/test/emulator/booking_create.test.js && node lib/test/emulator/booking_cancel.test.js && node lib/test/emulator/booking_reconfirm.test.js && node lib/test/emulator/booking_reconfirmation_deadline_worker.test.js && node lib/test/emulator/booking_queries.test.js && node lib/test/emulator/booking_contention.test.js",
    "test:emulator:booking:inside": "node lib/test/emulator/event_booking_projection.test.js && node lib/test/emulator/event_booking_delivery_scheduler.test.js && node lib/test/emulator/booking_create.test.js && node lib/test/emulator/booking_cancel.test.js && node lib/test/emulator/booking_reconfirm.test.js && node lib/test/emulator/booking_reconfirmation_deadline_worker.test.js && node lib/test/emulator/booking_queries.test.js && node lib/test/emulator/booking_contention.test.js && node lib/test/emulator/booking_security.test.js && node lib/test/emulator/booking_abuse_controls.test.js",
    "test:emulator:inside": "node ../scripts/run-emulator-test-groups.mjs",
    "test:emulator": "node ../scripts/run-emulator-tests.mjs",
    "test:booking:load:inside": "node --test --experimental-test-isolation=none lib/test/emulator/booking_load_evidence.test.js",
    "test:booking:load:local": "node ../scripts/run-emulator-tests.mjs --booking-load-evidence",
    "verify:generated": "node ../scripts/verify-generated-clean.mjs",
    "verify:reproducibility": "node ../scripts/verify-reproducibility.mjs",
    "verify:r1:layout": "node ../scripts/verify-r1-layout.mjs",
    "verify:r1:config": "node ../scripts/verify-r1-config.mjs",
    "verify:r1:exports": "node ../scripts/verify-r1-exports.mjs",
    "test:r1:unit": "npm run build --silent && node --test --experimental-test-isolation=none \"lib/test/unit/config/*.test.js\" \"lib/test/unit/security/*.test.js\" \"lib/test/unit/platform/*.test.js\" \"lib/test/unit/shared/server_clock.test.js\"",
    "test:r1:contract": "npm run build --silent && node --test --experimental-test-isolation=none \"lib/test/contract/platform_*.test.js\"",
    "test:r1:integration": "npm run build --silent && node --test --experimental-test-isolation=none \"lib/test/integration/*.test.js\"",
    "test:r1:emulator": "npm run test:emulator",
    "test:r1:rules": "npm run test:emulator",
    "test:r1": "node ../scripts/run-r1-gates.mjs",
    "verify:execution-manifest": "node ../scripts/verify-execution-manifest.mjs",
    "verify:iac:topology": "node ../scripts/verify-iac-topology.mjs",
    "infra:r1:validate": "terraform -chdir=../infra/terraform fmt -check && terraform -chdir=../infra/terraform init -backend=false -input=false && terraform -chdir=../infra/terraform validate",
    "infra:r1:plan": "terraform -chdir=../infra/terraform plan -input=false -lock=false -refresh=false -var-file=../env/dev.tfvars.example",
    "verify:reference-data:layout": "node ../scripts/verify-reference-data-layout.mjs",
    "verify:reference-data:contracts": "node ../scripts/verify-reference-data-contracts.mjs",
    "test:reference-data:unit": "npm run build --silent && node lib/test/reference_data/unit/reference_data_domain.test.js",
    "test:reference-data:contract": "npm run build --silent && node lib/test/reference_data/contract/reference_data_contracts.test.js",
    "test:reference-data:integration": "npm run build --silent && node lib/test/reference_data/integration/reference_data_service.test.js && node lib/test/reference_data/reconciliation/baltics_isolation.test.js && node lib/test/reference_data/security/reference_data_boundaries.test.js",
    "test:reference-data:emulator:inside": "node lib/test/reference_data/emulator/reference_data_collections.test.js",
    "test:reference-data": "npm run verify:reference-data:layout && npm run test:reference-data:unit && npm run test:reference-data:contract && npm run test:reference-data:integration",
    "verify:security-privacy:layout": "node ../scripts/verify-security-privacy-layout.mjs",
    "verify:security-privacy:contracts": "node ../scripts/verify-security-privacy-contracts.mjs",
    "test:security-privacy:unit": "npm run build --silent && node lib/test/unit/security/authentication_guard.test.js && node lib/test/unit/security/privacy_foundation.test.js && node lib/test/unit/privacy_orchestration/privacy_domain.test.js",
    "test:security-privacy:contract": "npm run build --silent && node lib/test/contract/privacy_fixture_parity.test.js",
    "test:security-privacy:integration": "npm run build --silent && node lib/test/integration/privacy_orchestration.test.js",
    "test:security-privacy": "npm run verify:security-privacy:layout && npm run test:security-privacy:unit && npm run test:security-privacy:contract && npm run test:security-privacy:integration",
    "verify:content-persistence:layout": "node ../scripts/verify-content-persistence-layout.mjs && node --test ../scripts/verify-content-persistence-layout.test.mjs",
    "verify:identity-publisher:layout": "node ../scripts/verify-identity-publisher-layout.mjs",
    "verify:identity-publisher:contracts": "node ../scripts/verify-identity-publisher-contracts.mjs",
    "test:identity-publisher:unit": "npm run build --silent && node --test --experimental-test-isolation=none \"lib/test/unit/identity_publisher/*.test.js\"",
    "test:identity-publisher:contract": "npm run build --silent && node lib/test/contract/identity_fixture_parity.test.js",
    "test:identity-publisher:integration": "npm run build --silent && node lib/test/integration/identity_publisher_authority.test.js",
    "test:identity-publisher": "npm run verify:identity-publisher:layout && npm run test:identity-publisher:unit && npm run test:identity-publisher:contract && npm run test:identity-publisher:integration",
    "stand:start": "node ../scripts/emulator-stand.mjs start",
    "stand:stop": "node ../scripts/emulator-stand.mjs stop",
    "stand:status": "node ../scripts/emulator-stand.mjs status",
    "stand:reset": "node ../scripts/emulator-stand.mjs reset",
    "stand:export": "node ../scripts/emulator-stand.mjs export",
    "stand:seed": "node ../scripts/stand-seed.mjs seed",
    "stand:verify": "node ../scripts/stand-seed.mjs verify",
    "stand:digest": "node ../scripts/stand-seed.mjs digest",
    "stand:acceptance": "node ../scripts/stand-acceptance.mjs",
    "stand:mobile-gate": "node ../scripts/stand-mobile-gate.mjs",
    "stand:booking-gate": "node ../scripts/stand-b2-gate.mjs",
    "stand:media-gate": "node ../scripts/stand-c1-gate.mjs",
    "stand:moderate": "node ../scripts/stand-moderate.mjs",
    "stand:moderation-gate": "node ../scripts/stand-c2-gate.mjs",
    "stand:event-gate": "node ../scripts/stand-c3-gate.mjs",
    "stand:catalog-gate": "node ../scripts/stand-e1-gate.mjs",
    "stand:discover-gate": "node ../scripts/stand-e2a-gate.mjs",
    "stand:e2-gate": "node ../scripts/stand-e2-gate.mjs",
    "stand:f1-gate": "node ../scripts/stand-f1-gate.mjs",
    "stand:f2-gate": "node ../scripts/stand-f2-gate.mjs",
    "test:media-tools": "npm run build --silent && node --test --experimental-test-isolation=none \"lib/test/media_tools/*.test.js\"",
    "stand:d1-gate": "node ../scripts/stand-d1-gate.mjs",
    "stand:manifest": "node ../scripts/stand-seed.mjs manifest",
    "test:stand": "node --test ../scripts/emulator-stand.test.mjs lib/test/stand/*.test.js",
    "test:emulator:platform": "node ../scripts/run-emulator-tests.mjs --group platform",
    "test:emulator:booking": "node ../scripts/run-emulator-tests.mjs --group booking",
    "test:emulator:content-media": "node ../scripts/run-emulator-tests.mjs --group content-media",
    "test:emulator:handoff-notifications": "node ../scripts/run-emulator-tests.mjs --group handoff-notifications",
    "test:emulator:place-activity": "node ../scripts/run-emulator-tests.mjs --group place-activity",
    "test:emulator:rental": "node ../scripts/run-emulator-tests.mjs --group rental",
    "test:emulator:rules-reference": "node ../scripts/run-emulator-tests.mjs --group rules-reference",
    "test:emulator:runner": "node --test ../scripts/run-emulator-test-groups.test.mjs",
    "build:taxonomy": "node ../scripts/build-taxonomy-dataset.mjs",
    "verify:taxonomy": "node ../scripts/build-taxonomy-dataset.mjs --check"
  },
  "dependencies": {
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "firebase-tools": "15.28.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
