rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // R1 platform records are server-owned. Local Admin SDK tests may exercise
    // them, but no mobile/client identity has direct access.
    match /platformReleaseManifests/{document} { allow read, write: if false; }
    match /platformActiveReleasePointers/{document} { allow read, write: if false; }
    match /platformFeatureFlagRevisions/{document} { allow read, write: if false; }
    match /platformActiveFeatureFlagPointers/{document} { allow read, write: if false; }
    match /referenceMarketConfigRevisions/{document} { allow read, write: if false; }
    match /referenceActivationPointers/{document} { allow read, write: if false; }

    // Security/Privacy foundation records are server-owned. The actor-owned
    // direct-client allowlist is intentionally empty until an owning domain
    // approves an exact record contract and Rules slice.
    match /privacyRequests/{document} { allow read, write: if false; }
    match /privacyDomainTasks/{document} { allow read, write: if false; }
    match /securityAuditEvents/{document} { allow read, write: if false; }

    // Identity/Publisher local authority may be exercised through the
    // Emulator-only Admin repository. It remains server-owned and no client
    // role, page, provider assertion or session handle is accepted directly.
    match /identityAccounts/{document} { allow read, write: if false; }
    match /identityProviderLinks/{document} { allow read, write: if false; }
    match /identitySessions/{document} { allow read, write: if false; }
    match /identityAccessSnapshots/{document} { allow read, write: if false; }
    match /identityCreatorVerifications/{document} { allow read, write: if false; }
    match /identityManagedPages/{document} { allow read, write: if false; }
    match /identityPageMemberships/{document} { allow read, write: if false; }

    // RAW-C authoritative records are Admin-SDK-only. There is deliberately no
    // client exception, including for owners, flags, projections or outbox.
    match /bookingEventProjections/{document} { allow read, write: if false; }
    match /bookings/{document} { allow read, write: if false; }
    match /bookingHolds/{document} { allow read, write: if false; }
    match /bookingPoolLedgers/{document} { allow read, write: if false; }
    match /bookingUserUsage/{document} { allow read, write: if false; }
    match /bookingActiveKeys/{document} { allow read, write: if false; }
    match /bookingIdempotency/{document} { allow read, write: if false; }
    match /bookingAudit/{document} { allow read, write: if false; }
    match /bookingOutbox/{document} { allow read, write: if false; }
    match /eventBookingOutbox/{document} { allow read, write: if false; }
    match /bookingProjectionDeliveries/{document} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
