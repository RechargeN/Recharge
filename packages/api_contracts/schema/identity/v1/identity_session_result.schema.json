{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/identity/v1/identity_session_result.schema.json",
  "title": "EstablishIdentitySessionResultV1",
  "$defs": {
    "failureCode": {
      "enum": [
        "account_blocked",
        "account_creation_disabled",
        "account_restricted",
        "app_check_required",
        "capability_denied",
        "contention",
        "creator_verification_required",
        "creator_verification_unavailable",
        "feature_disabled",
        "invalid_contract",
        "invalid_transition",
        "membership_inactive",
        "not_found_or_not_accessible",
        "policy_unavailable",
        "provider_assertion_invalid",
        "provider_subject_conflict",
        "publisher_not_accessible",
        "rate_limited",
        "recent_auth_required",
        "revision_conflict",
        "session_expired",
        "session_limit_reached",
        "session_revoked",
        "snapshot_stale",
        "temporarily_unavailable",
        "unauthenticated",
        "unsupported_schema"
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "commandType",
        "requestId",
        "serverTime",
        "kind",
        "data"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "commandType": {
          "enum": [
            "establishIdentitySession",
            "refreshIdentitySession",
            "recoverIdentitySessions"
          ]
        },
        "requestId": { "type": "string" },
        "serverTime": { "type": "string", "format": "date-time" },
        "kind": { "const": "succeeded" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessionContext"],
          "properties": {
            "sessionContext": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "userId",
                "sessionId",
                "sessionHandle",
                "installationId",
                "expiresAtUtc"
              ],
              "properties": {
                "userId": { "type": "string" },
                "sessionId": { "type": "string" },
                "sessionHandle": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "installationId": { "type": "string" },
                "expiresAtUtc": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "commandType",
        "requestId",
        "serverTime",
        "kind",
        "error"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "commandType": {
          "enum": [
            "establishIdentitySession",
            "refreshIdentitySession",
            "recoverIdentitySessions"
          ]
        },
        "requestId": { "type": "string" },
        "serverTime": { "type": "string", "format": "date-time" },
        "kind": { "enum": ["rejected", "retryableFailure"] },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "code", "retryable", "correlationId"],
          "properties": {
            "schemaVersion": { "const": 1 },
            "code": { "$ref": "#/$defs/failureCode" },
            "retryable": { "type": "boolean" },
            "correlationId": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "retryAfter": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  ]
}
