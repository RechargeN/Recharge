{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/identity/v1/seller_declaration.schema.json",
  "title": "SellerDeclarationV1 (DSA Art. 30 trader traceability, ADR 0023 2026-11-08)",
  "$defs": {
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "contact", "dac7ActivityTypes"],
      "properties": {
        "status": {
          "enum": ["private", "trader"]
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "email": {
              "type": "string",
              "maxLength": 254,
              "pattern": "^[^@\\s]{1,64}@[^@\\s]{1,189}\\.[^@\\s]{2,}$"
            },
            "phone": {
              "type": "string",
              "pattern": "^\\+[1-9][0-9]{6,14}$"
            }
          }
        },
        "trader": {
          "type": "object",
          "additionalProperties": false,
          "required": ["legalName", "registrationNumber", "address"],
          "properties": {
            "legalName": {
              "type": "string",
              "minLength": 2,
              "maxLength": 160
            },
            "registrationNumber": {
              "type": "string",
              "pattern": "^[A-Za-z0-9 ./-]{3,40}$"
            },
            "vatId": {
              "type": "string",
              "pattern": "^[A-Z]{2}[A-Za-z0-9]{2,13}$"
            },
            "address": {
              "type": "object",
              "additionalProperties": false,
              "required": ["line1", "city", "postalCode", "countryCode"],
              "properties": {
                "line1": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 160
                },
                "city": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "postalCode": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9 -]{2,12}$"
                },
                "countryCode": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                }
              }
            }
          }
        },
        "dac7ActivityTypes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 2,
          "items": {
            "enum": ["personalServices", "rentalOfGoods"]
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "trader"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "trader": true
        },
        "required": ["trader"]
      },
      "else": {
        "not": {
          "properties": {
            "trader": true
          },
          "required": ["trader"]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "userId",
    "declaration",
    "revision",
    "declaredAtUtc"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "userId": {
      "$ref": "identity_common.schema.json#/$defs/entityId"
    },
    "declaration": {
      "$ref": "#/$defs/declaration"
    },
    "revision": {
      "$ref": "identity_common.schema.json#/$defs/revision"
    },
    "declaredAtUtc": {
      "$ref": "identity_common.schema.json#/$defs/utcInstant"
    }
  }
}
