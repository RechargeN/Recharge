{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/identity/v1/creator_verification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verificationId",
    "userId",
    "status",
    "revision",
    "submittedAtUtc",
    "evidenceRefIds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "verificationId": { "$ref": "identity_common.schema.json#/$defs/entityId" },
    "userId": { "$ref": "identity_common.schema.json#/$defs/entityId" },
    "status": {
      "enum": ["pendingReview", "verified", "rejected", "suspended", "revoked"]
    },
    "revision": { "$ref": "identity_common.schema.json#/$defs/revision" },
    "submittedAtUtc": {
      "$ref": "identity_common.schema.json#/$defs/utcInstant"
    },
    "decidedAtUtc": { "$ref": "identity_common.schema.json#/$defs/utcInstant" },
    "evidenceRefIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "items": { "$ref": "identity_common.schema.json#/$defs/entityId" }
    }
  }
}
