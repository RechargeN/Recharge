{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/identity/v1/identity_session_command.schema.json",
  "title": "EstablishIdentitySessionCommandV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandType", "requestId", "installationId"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "commandType": { "const": "establishIdentitySession" },
    "requestId": { "type": "string", "pattern": "^(?!__name__$)[A-Za-z0-9_-]{1,128}$" },
    "installationId": {
      "type": "string",
      "pattern": "^(?!__name__$)[A-Za-z0-9._:-]{1,128}$"
    }
  }
}
