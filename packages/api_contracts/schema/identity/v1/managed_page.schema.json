{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/identity/v1/managed_page.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pageId",
    "ownerUserId",
    "marketId",
    "status",
    "verificationStatus",
    "revision",
    "createdAtUtc",
    "updatedAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "pageId": { "$ref": "identity_common.schema.json#/$defs/entityId" },
    "ownerUserId": { "$ref": "identity_common.schema.json#/$defs/entityId" },
    "marketId": { "$ref": "identity_common.schema.json#/$defs/marketId" },
    "status": { "enum": ["pendingReview", "active", "restricted", "archived"] },
    "verificationStatus": {
      "enum": [
        "unverified",
        "pendingReview",
        "verified",
        "rejected",
        "suspended",
        "revoked"
      ]
    },
    "revision": { "$ref": "identity_common.schema.json#/$defs/revision" },
    "createdAtUtc": { "$ref": "identity_common.schema.json#/$defs/utcInstant" },
    "updatedAtUtc": { "$ref": "identity_common.schema.json#/$defs/utcInstant" }
  }
}
