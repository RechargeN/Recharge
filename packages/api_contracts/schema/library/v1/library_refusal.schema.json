{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/library/v1/library_refusal.schema.json",
  "title": "LibraryRefusalV1",
  "description": "L4.8: the refusal branch of the library callables only; success answers have no schema yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "code"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "rejected",
        "retryableFailure"
      ]
    },
    "code": {
      "$ref": "#/$defs/refusalCode"
    },
    "retryAfterSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "currentRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ownerRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "refusalCode": {
      "enum": [
        "app_check_required",
        "cursor_invalid",
        "feature_disabled",
        "idempotency_conflict",
        "object_unavailable",
        "owner_changed",
        "permission_denied",
        "place_timezone_invalid",
        "processing_restricted",
        "request_invalid",
        "revision_conflict",
        "snapshot_changed",
        "temporarily_unavailable",
        "unauthenticated",
        "visit_date_future"
      ]
    }
  }
}
