{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/notifications/v1/push_device_command.schema.json",
  "title": "PushDeviceCommandV1 (N3c, 2026-11-13)",
  "description": "Registers or removes the FCM token of the caller's current Session installation. The installation comes from the Session, never from the payload.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "commandType", "payload"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "commandType": {
          "const": "registerPushDevice"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "token"],
          "properties": {
            "platform": {
              "const": "android"
            },
            "token": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_:\\-.]{20,4096}$"
            },
            "locale": {
              "description": "App language for the generic lock-screen text (A34 2026-11-13).",
              "enum": ["lv-LV", "en", "ru"]
            }
          }
        },
        "sessionContext": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "commandType", "payload"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "commandType": {
          "const": "unregisterPushDevice"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "sessionContext": {
          "type": "object"
        }
      }
    }
  ]
}
