{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/notifications/v1/notifications_query.schema.json",
  "title": "Recharge Notifications query request union v1 (F1, local stand contract)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "requestId": { "$ref": "#/$defs/requestId" },
        "queryType": { "const": "listInbox" },
        "sessionContext": { "type": "object" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "locale": { "$ref": "#/$defs/locale" },
            "view": { "enum": ["active", "archived"] },
            "pageSize": { "type": "integer", "minimum": 1, "maximum": 50 },
            "cursor": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "required": ["locale"]
        }
      },
      "required": ["schemaVersion", "requestId", "queryType", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "requestId": { "$ref": "#/$defs/requestId" },
        "queryType": { "enum": ["unreadSummary", "getPreferences"] },
        "sessionContext": { "type": "object" },
        "payload": { "type": "object", "additionalProperties": false, "maxProperties": 0 }
      },
      "required": ["schemaVersion", "requestId", "queryType", "payload"]
    }
  ],
  "$defs": {
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "locale": { "enum": ["lv-LV", "en", "ru"] }
  }
}
