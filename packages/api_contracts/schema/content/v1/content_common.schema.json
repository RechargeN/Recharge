{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/content/v1/content_common.schema.json",
  "title": "Recharge Content v1 common values",
  "$defs": {
    "entityId": {
      "type": "string",
      "anyOf": [{ "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }, { "format": "uuid" }]
    },
    "utcInstant": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "marketId": { "enum": ["LV", "EE", "LT"] },
    "typeId": {
      "enum": [
        "event",
        "activity",
        "route",
        "place",
        "session",
        "scenario",
        "find_people",
        "class_workshop",
        "rental",
        "collection"
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "referenceRevisionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "publisherRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["user", "page"] },
        "id": { "$ref": "#/$defs/entityId" }
      }
    },
    "referenceRevisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marketConfigRevisionId", "taxonomyRevisionId", "localizationRevisionId"],
      "properties": {
        "marketConfigRevisionId": { "$ref": "#/$defs/referenceRevisionId" },
        "taxonomyRevisionId": { "$ref": "#/$defs/referenceRevisionId" },
        "localizationRevisionId": { "$ref": "#/$defs/referenceRevisionId" }
      }
    },
    "contentBody": { "type": "object" }
  }
}
