{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/content/v1/published_revision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentId",
    "publishedRevisionId",
    "revisionNumber",
    "draftId",
    "submissionId",
    "typeId",
    "publisherRef",
    "marketId",
    "body",
    "bodyHash",
    "referenceRevisions",
    "mediaRevision",
    "mediaAttachments",
    "publishedAtUtc",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentId": {
      "$ref": "content_common.schema.json#/$defs/entityId"
    },
    "publishedRevisionId": {
      "$ref": "content_common.schema.json#/$defs/entityId"
    },
    "revisionNumber": {
      "$ref": "content_common.schema.json#/$defs/positiveRevision"
    },
    "draftId": {
      "$ref": "content_common.schema.json#/$defs/entityId"
    },
    "submissionId": {
      "$ref": "content_common.schema.json#/$defs/entityId"
    },
    "typeId": {
      "$ref": "content_common.schema.json#/$defs/typeId"
    },
    "publisherRef": {
      "$ref": "content_common.schema.json#/$defs/publisherRef"
    },
    "marketId": {
      "$ref": "content_common.schema.json#/$defs/marketId"
    },
    "body": {
      "$ref": "content_common.schema.json#/$defs/contentBody"
    },
    "bodyHash": {
      "$ref": "content_common.schema.json#/$defs/sha256Hex"
    },
    "referenceRevisions": {
      "$ref": "content_common.schema.json#/$defs/referenceRevisions"
    },
    "mediaRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "mediaAttachments": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "content_common.schema.json#/$defs/mediaAttachment"
      }
    },
    "publishedAtUtc": {
      "$ref": "content_common.schema.json#/$defs/utcInstant"
    },
    "provenance": {
      "$ref": "content_common.schema.json#/$defs/provenance"
    }
  }
}
