{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/content/v1/publication_pointer.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentId",
    "currentPublishedRevisionId",
    "previousPublishedRevisionId",
    "visibility",
    "ownerHold",
    "moderationHold",
    "revision",
    "updatedAtUtc"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentId": {
      "$ref": "content_common.schema.json#/$defs/entityId"
    },
    "currentPublishedRevisionId": {
      "anyOf": [
        {
          "$ref": "content_common.schema.json#/$defs/entityId"
        },
        {
          "type": "null"
        }
      ]
    },
    "previousPublishedRevisionId": {
      "anyOf": [
        {
          "$ref": "content_common.schema.json#/$defs/entityId"
        },
        {
          "type": "null"
        }
      ]
    },
    "visibility": {
      "enum": [
        "visible",
        "withdrawn",
        "restricted",
        "archived"
      ]
    },
    "revision": {
      "$ref": "content_common.schema.json#/$defs/positiveRevision"
    },
    "updatedAtUtc": {
      "$ref": "content_common.schema.json#/$defs/utcInstant"
    },
    "ownerHold": {
      "enum": [
        "withdrawn",
        "archived",
        null
      ]
    },
    "moderationHold": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "decisionId"
          ],
          "properties": {
            "kind": {
              "enum": [
                "restricted",
                "withdrawn"
              ]
            },
            "decisionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      ]
    },
    "mediaConfirmations": {
      "description": "D2: Media revocation epochs the publisher confirmed; absent when none.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "revocationEpoch"
        ],
        "properties": {
          "assetId": {
            "$ref": "content_common.schema.json#/$defs/entityId"
          },
          "revocationEpoch": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "mediaSuppression": {
      "description": "D2: attached media Content stopped showing; absent when none.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "reason",
          "observedEpoch"
        ],
        "properties": {
          "assetId": {
            "$ref": "content_common.schema.json#/$defs/entityId"
          },
          "reason": {
            "enum": [
              "revoked",
              "deleted"
            ]
          },
          "observedEpoch": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "visibility": {
            "const": "visible"
          }
        },
        "required": [
          "visibility"
        ]
      },
      "then": {
        "properties": {
          "ownerHold": {
            "const": null
          },
          "moderationHold": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "visibility": {
            "const": "restricted"
          }
        },
        "required": [
          "visibility"
        ]
      },
      "then": {
        "properties": {
          "moderationHold": {
            "type": "object"
          }
        },
        "required": [
          "moderationHold"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "visibility": {
            "const": "archived"
          }
        },
        "required": [
          "visibility"
        ]
      },
      "then": {
        "properties": {
          "ownerHold": {
            "const": "archived"
          },
          "moderationHold": {
            "const": null
          }
        }
      }
    }
  ]
}
