{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/booking/v1/common.schema.json",
  "title": "Recharge Booking v1 common definitions",
  "$defs": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!__name__$)[A-Za-z0-9_-]+$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!__name__$)[A-Za-z0-9_-]+$"
    },
    "sessionContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": { "$ref": "#/$defs/id" },
        "sessionHandle": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "installationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!__name__$)[A-Za-z0-9._:-]+$"
        }
      },
      "required": ["sessionId", "sessionHandle", "installationId"]
    },
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[\\u0020-\\u007E]+$"
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 20
    },
    "positiveUnits": { "type": "integer", "minimum": 1, "maximum": 21 },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "admissionMode": {
      "type": "string",
      "enum": ["rsvp", "booking", "application"]
    },
    "confirmationMode": {
      "type": "string",
      "enum": ["instant", "manualApproval"]
    },
    "bookingState": {
      "type": "string",
      "enum": ["pending", "confirmed", "cancelled", "expired", "waitlisted"]
    },
    "channel": {
      "type": "string",
      "enum": ["onsite", "online", "any"]
    },
    "reconfirmationState": {
      "type": "string",
      "enum": ["notRequired", "notOpen", "required", "confirmed", "missed"]
    },
    "terminalReason": {
      "type": "string",
      "enum": [
        "userCancelled",
        "organizerCancelled",
        "applicationRejected",
        "occurrenceCancelled",
        "privacyErasure",
        "eventCancelled",
        "missedReconfirmation",
        "waitlistOfferDeclined",
        "waitlistOfferExpired",
        "duplicateResolved",
        "policyInvalidated"
      ]
    },
    "namedGuest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 }
      },
      "required": ["displayName"]
    }
  }
}
