{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/content_translation/v1/content_translation_request.schema.json",
  "title": "Recharge content translation request v1 (ADR 0022 stage 1, local stand contract)",
  "description": "Used by offerContentTranslationV1 and translateContentV1. It carries no text: the server reads the public revision itself.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "contentId": { "type": "string", "minLength": 26, "maxLength": 36 },
    "publishedRevisionId": { "type": "string", "minLength": 26, "maxLength": 36 },
    "targetLocale": { "type": "string", "pattern": "^[A-Za-z-]{2,16}$" }
  },
  "required": ["schemaVersion", "requestId", "contentId", "publishedRevisionId", "targetLocale"]
}
