{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/quick_plan/v1/quick_plan_refusal.schema.json",
  "title": "QuickPlanRefusalV1",
  "description": "L4.8: the refusal branch of the quick_plan callables only; success answers have no schema yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "code"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "rejected",
        "retryableFailure"
      ]
    },
    "code": {
      "$ref": "#/$defs/refusalCode"
    },
    "retryAfterSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "serverRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "refusalCode": {
      "enum": [
        "access_denied",
        "access_revoked",
        "app_check_required",
        "deleted",
        "feature_disabled",
        "id_collision",
        "idempotency_conflict",
        "invite_limit",
        "owner_changed",
        "permission_denied",
        "request_invalid",
        "revision_conflict",
        "target_unavailable",
        "temporarily_unavailable",
        "unauthenticated"
      ]
    }
  }
}
