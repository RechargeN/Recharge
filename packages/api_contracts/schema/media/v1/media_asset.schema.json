{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/media/v1/media_asset.schema.json",
  "$defs": {
    "deletionStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "assetId": {
          "$ref": "media_common.schema.json#/$defs/entityId"
        },
        "state": {
          "enum": [
            "pending",
            "completed"
          ]
        },
        "reason": {
          "enum": [
            "owner_request",
            "orphan_cleanup",
            "expired_upload"
          ]
        },
        "deletionRevision": {
          "$ref": "media_common.schema.json#/$defs/positiveRevision"
        },
        "requestedAtUtc": {
          "$ref": "media_common.schema.json#/$defs/utcInstant"
        },
        "completedAtUtc": {
          "$ref": "media_common.schema.json#/$defs/utcInstant"
        }
      },
      "required": [
        "schemaVersion",
        "assetId",
        "state",
        "reason",
        "deletionRevision",
        "requestedAtUtc"
      ]
    },
    "orphanReconciliation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "assetId": {
          "$ref": "media_common.schema.json#/$defs/entityId"
        },
        "action": {
          "enum": [
            "keep",
            "marked",
            "unmarked",
            "deleting",
            "deleted",
            "recovered"
          ]
        },
        "assetRevision": {
          "$ref": "media_common.schema.json#/$defs/positiveRevision"
        }
      },
      "required": [
        "schemaVersion",
        "assetId",
        "action",
        "assetRevision"
      ]
    },
    "processingReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "assetId": {
          "$ref": "media_common.schema.json#/$defs/entityId"
        },
        "attemptNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "sourceProviderGeneration": {
          "$ref": "media_common.schema.json#/$defs/providerGeneration"
        },
        "sourceSha256": {
          "$ref": "media_common.schema.json#/$defs/sha256Hex"
        },
        "policyRevision": {
          "$ref": "media_common.schema.json#/$defs/revisionLabel"
        },
        "scan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "toolRevision": {
              "$ref": "media_common.schema.json#/$defs/revisionLabel"
            },
            "result": {
              "enum": [
                "clean",
                "rejected",
                "inconclusive"
              ]
            }
          },
          "required": [
            "toolRevision",
            "result"
          ]
        },
        "processing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "toolRevision": {
              "$ref": "media_common.schema.json#/$defs/revisionLabel"
            },
            "result": {
              "enum": [
                "succeeded",
                "failed",
                "rejected"
              ]
            },
            "variantManifestRevision": {
              "$ref": "media_common.schema.json#/$defs/sha256Hex"
            }
          },
          "required": [
            "toolRevision",
            "result"
          ]
        },
        "outcome": {
          "enum": [
            "ready",
            "quarantined",
            "blocked"
          ]
        },
        "startedAtUtc": {
          "$ref": "media_common.schema.json#/$defs/utcInstant"
        },
        "completedAtUtc": {
          "$ref": "media_common.schema.json#/$defs/utcInstant"
        }
      },
      "required": [
        "schemaVersion",
        "assetId",
        "attemptNumber",
        "sourceProviderGeneration",
        "sourceSha256",
        "policyRevision",
        "scan",
        "outcome",
        "startedAtUtc",
        "completedAtUtc"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetId",
    "ownerSubjectId",
    "marketId",
    "family",
    "visibilityClass",
    "lifecycle",
    "variantRefs",
    "policyRevision",
    "deliveryDisabled",
    "attemptCount",
    "revision",
    "createdAtUtc",
    "updatedAtUtc"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "assetId": {
      "$ref": "media_common.schema.json#/$defs/entityId"
    },
    "ownerSubjectId": {
      "$ref": "media_common.schema.json#/$defs/entityId"
    },
    "publisherRef": {
      "$ref": "media_common.schema.json#/$defs/publisherRef"
    },
    "entityBinding": {
      "$ref": "media_common.schema.json#/$defs/entityBinding"
    },
    "marketId": {
      "$ref": "media_common.schema.json#/$defs/marketId"
    },
    "family": {
      "$ref": "media_common.schema.json#/$defs/family"
    },
    "visibilityClass": {
      "$ref": "media_common.schema.json#/$defs/visibilityClass"
    },
    "lifecycle": {
      "$ref": "media_common.schema.json#/$defs/lifecycle"
    },
    "sourceGenerationRef": {
      "$ref": "media_common.schema.json#/$defs/objectGenerationRef"
    },
    "variantManifestRevision": {
      "$ref": "media_common.schema.json#/$defs/sha256Hex"
    },
    "variantRefs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "media_common.schema.json#/$defs/variantRef"
      }
    },
    "policyRevision": {
      "$ref": "media_common.schema.json#/$defs/revisionLabel"
    },
    "deliveryDisabled": {
      "type": "boolean"
    },
    "restricted": {
      "type": "boolean"
    },
    "deletionHold": {
      "type": "boolean"
    },
    "attemptCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "revision": {
      "$ref": "media_common.schema.json#/$defs/positiveRevision"
    },
    "createdAtUtc": {
      "$ref": "media_common.schema.json#/$defs/utcInstant"
    },
    "updatedAtUtc": {
      "$ref": "media_common.schema.json#/$defs/utcInstant"
    },
    "deletedAtUtc": {
      "$ref": "media_common.schema.json#/$defs/utcInstant"
    },
    "orphanSinceUtc": {
      "$ref": "media_common.schema.json#/$defs/utcInstant"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "ready"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "required": [
          "sourceGenerationRef",
          "variantManifestRevision"
        ],
        "properties": {
          "sourceGenerationRef": true,
          "variantManifestRevision": true,
          "variantRefs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "deleted"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "required": [
          "deletedAtUtc"
        ],
        "properties": {
          "deletedAtUtc": true
        }
      }
    }
  ]
}
