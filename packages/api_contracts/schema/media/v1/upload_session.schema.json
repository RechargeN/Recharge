{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recharge.app/schemas/media/v1/upload_session.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "uploadSessionId",
    "assetId",
    "ownerSubjectId",
    "marketId",
    "allowedFamily",
    "allowedMediaTypes",
    "maxBytes",
    "expiresAtUtc",
    "state",
    "revision",
    "createdAtUtc"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "uploadSessionId": {
      "$ref": "media_common.schema.json#/$defs/entityId"
    },
    "assetId": {
      "$ref": "media_common.schema.json#/$defs/entityId"
    },
    "ownerSubjectId": {
      "$ref": "media_common.schema.json#/$defs/entityId"
    },
    "publisherRef": {
      "$ref": "media_common.schema.json#/$defs/publisherRef"
    },
    "entityIntent": {
      "$ref": "media_common.schema.json#/$defs/entityBinding"
    },
    "marketId": {
      "$ref": "media_common.schema.json#/$defs/marketId"
    },
    "allowedFamily": {
      "$ref": "media_common.schema.json#/$defs/family"
    },
    "allowedMediaTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "media_common.schema.json#/$defs/mediaType"
      }
    },
    "maxBytes": {
      "$ref": "media_common.schema.json#/$defs/byteLength"
    },
    "expiresAtUtc": {
      "$ref": "media_common.schema.json#/$defs/utcInstant"
    },
    "state": {
      "enum": [
        "open",
        "completed",
        "expired",
        "aborted"
      ]
    },
    "revision": {
      "$ref": "media_common.schema.json#/$defs/positiveRevision"
    },
    "createdAtUtc": {
      "$ref": "media_common.schema.json#/$defs/utcInstant"
    },
    "completedAtUtc": {
      "$ref": "media_common.schema.json#/$defs/utcInstant"
    }
  }
}
